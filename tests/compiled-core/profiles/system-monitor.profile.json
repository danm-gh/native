    "abi_version": 1,
    "snapshot_format": 1,
    "build_id_symbol": "nsc_core_build_id",
    "abi_version_symbol": "nsc_core_abi_version",
    "model": "Model",
    "msg": "Msg",
    "init_export": "init",
    "update_export": "coreUpdate",
    "subscriptions_export": "coreSubscriptions",
