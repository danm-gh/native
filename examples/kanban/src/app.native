<!-- The TypeScript Kanban view. Native file drops are handled by core.ts's
     dropMsg channel; every dropped basename becomes a Todo card. Keep this
     initial document self-contained: generated TS wiring embeds app.native
     as the boot view, before the development disk watcher is armed. -->
<column background="background">
  <!-- The header IS the titlebar (tall hidden-inset chrome). chromeMsg
       keeps its controls clear of the traffic lights. -->
  <row height="{headerHeight}" padding="12" gap="10" cross="center" background="surface" window-drag="true" label="Kanban header">
    <spacer width="{chromeLeading}" />
    <text size="sm" foreground="text_muted">Pick up a card and make some space · drop files to add more</text>
    <spacer grow="1" />
    <button variant="primary" on-press="add">Add card</button>
  </row>
  <separator />
  <row grow="1" gap="12" padding="16">
    <column grow="1" gap="8" padding="10" label="Todo">
      <text foreground="text_muted">Todo</text>
      <column gap="8">
        <for each="todoCards" key="id" as="c">
          <row global-key="{c.id}" on-drag="card_dropped:{c.id}" background="surface" radius="md" gap="8" padding="8" cross="center" role="listitem" label="{c.title}">
            <text grow="1">{c.title}</text>
          </row>
        </for>
      </column>
    </column>
    <column grow="1" gap="8" padding="10" label="Doing">
      <text foreground="text_muted">Doing</text>
      <column gap="8">
        <for each="doingCards" key="id" as="c">
          <row global-key="{c.id}" on-drag="card_dropped:{c.id}" background="surface" radius="md" gap="8" padding="8" cross="center" role="listitem" label="{c.title}">
            <text grow="1">{c.title}</text>
          </row>
        </for>
      </column>
    </column>
    <column grow="1" gap="8" padding="10" label="Done">
      <text foreground="text_muted">Done</text>
      <column gap="8">
        <for each="doneCards" key="id" as="c">
          <row global-key="{c.id}" on-drag="card_dropped:{c.id}" background="surface" radius="md" gap="8" padding="8" cross="center" role="listitem" label="{c.title}">
            <text grow="1">{c.title}</text>
          </row>
        </for>
      </column>
    </column>
  </row>
  <status-bar>{todoCount} todo · {doingCount} doing · {doneCount} done · {droppedCount} added from files</status-bar>
</column>
