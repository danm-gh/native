    { "export": "dispatch_bool", "symbol": "nsc_core_dispatch_bool", "params": ["u8", "u8"], "returns": "bytes" },
    { "export": "dispatch_enum", "symbol": "nsc_core_dispatch_enum", "params": ["u8", "u32"], "returns": "bytes" },
    { "export": "dispatch_record", "symbol": "nsc_core_dispatch_record", "params": ["u8", "bytes"], "returns": "bytes" },
    { "export": "dispatch_text_input", "symbol": "nsc_core_dispatch_text_input", "params": ["u8", "bytes"], "returns": "bytes" },
    { "export": "dispatch_scroll_state", "symbol": "nsc_core_dispatch_scroll_state", "params": ["u8", "f64", "f64", "f64", "f64", "f64", "f64", "f64", "f64"], "returns": "bytes" },
    { "export": "subscriptions", "symbol": "nsc_core_subscriptions", "params": [], "returns": "bytes" },
    { "export": "model_snapshot", "symbol": "nsc_core_model_snapshot", "params": [], "returns": "bytes" },
    { "export": "helper_call", "symbol": "nsc_core_helper_call", "params": ["u32", "bytes"], "returns": "bytes" }
  ],
  "sidecar": {
