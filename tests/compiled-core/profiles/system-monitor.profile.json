    { "export": "dispatch_bytes", "symbol": "nsc_core_dispatch_bytes", "params": ["u8", "bytes"], "returns": "bytes" },
    { "export": "dispatch_number", "symbol": "nsc_core_dispatch_number", "params": ["u8", "f64"], "returns": "bytes" },
